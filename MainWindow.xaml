<Window x:Class="LanMouse.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LAN Mouse" Width="440" SizeToContent="Height"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" FontFamily="{StaticResource Ui}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="38" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
  <StackPanel>
    <!-- Title bar -->
    <Grid Height="38">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <Image x:Name="Logo" Width="16" Height="16" Margin="0,0,9,0"/>
        <TextBlock x:Name="PageTitle" Text="LAN Mouse" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource Sub}"/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="SettingsBtn" Style="{StaticResource Caption}" Content="&#xE713;" FontSize="13" Click="Settings_Click" ToolTip="Settings"/>
        <Button Style="{StaticResource Caption}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimize"/>
        <Button Style="{StaticResource Caption}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Hide to tray"/>
      </StackPanel>
    </Grid>

    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="18,6,18,18">
    <StackPanel x:Name="HomePage">

      <!-- Status -->
      <Border Style="{StaticResource CardBox}" Padding="18,16">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid Width="14" Height="14" VerticalAlignment="Top" Margin="0,6,14,0">
              <Ellipse x:Name="StatusHalo" Width="14" Height="14" Fill="#8A93A4" Opacity="0.25"/>
              <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="#8A93A4"/>
            </Grid>
            <StackPanel Grid.Column="1">
              <TextBlock x:Name="StatusTitle" Text="Not connected" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="StatusSub" Text="Press Connect on both PCs" Foreground="{StaticResource Sub}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <Border x:Name="WarningBox" Visibility="Collapsed" Background="#2A2214" CornerRadius="9" Padding="10,8" Margin="0,12,0,0">
            <TextBlock x:Name="WarningText" Foreground="{StaticResource Amber}" FontSize="12" TextWrapping="Wrap"/>
          </Border>
          <StackPanel x:Name="ProgressBox" Visibility="Collapsed" Margin="0,12,0,0">
            <Grid>
              <TextBlock x:Name="ProgressText" FontSize="12" Foreground="{StaticResource Sub}"/>
              <TextBlock x:Name="ProgressPct" FontSize="12" Foreground="{StaticResource Sub}" HorizontalAlignment="Right"/>
            </Grid>
            <Border Height="5" CornerRadius="2.5" Background="#252A34" Margin="0,6,0,0" ClipToBounds="True">
              <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="2.5" Background="{StaticResource Accent}"/>
            </Border>
          </StackPanel>
          <Button x:Name="ReleaseBtn" Style="{StaticResource Ghost}" Visibility="Collapsed" HorizontalAlignment="Left" Margin="-10,8,0,-6"
                  Click="Release_Click" Content="Bring cursor back here  (Scroll Lock)" Foreground="{StaticResource Accent}"/>
        </StackPanel>
      </Border>

      <!-- Arrangement -->
      <TextBlock Text="WHERE IS YOUR OTHER PC?" Style="{StaticResource Label}" Margin="2,20,0,8"/>
      <Border Style="{StaticResource CardBox}" Padding="12">
        <StackPanel>
          <Canvas x:Name="DisplayMap" Height="230" ClipToBounds="True" Background="Transparent"
                  SizeChanged="DisplayMap_SizeChanged"
                  MouseLeftButtonDown="DisplayMap_Down" MouseMove="DisplayMap_Move" MouseLeftButtonUp="DisplayMap_Up"
                  LostMouseCapture="DisplayMap_LostCapture"/>
          <TextBlock x:Name="DisplayHint" Foreground="{StaticResource Sub}" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Margin="10,8,10,2"/>
        </StackPanel>
      </Border>

      <Button x:Name="ConnectBtn" Style="{StaticResource Primary}" Content="Connect" Margin="0,20,0,0" Click="Connect_Click"/>

      <Button x:Name="OpenSettingsLink" Style="{StaticResource Ghost}" HorizontalAlignment="Center" Margin="0,12,0,0"
              Content="Settings: pairing key, hotkeys, sharing" Click="Settings_Click"/>
    </StackPanel>

    <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
      <Button Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-10,0,0,-8" Click="Back_Click">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          <TextBlock Text="Back" FontSize="13" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
        </StackPanel>
      </Button>
      <!-- Pairing -->
      <TextBlock Text="PAIRING" Style="{StaticResource Label}" Margin="2,14,0,8"/>
      <Border Style="{StaticResource CardBox}">
        <StackPanel>
          <TextBlock Text="Pairing key (type the same one on both PCs)" Foreground="{StaticResource Sub}" FontSize="12" Margin="0,0,0,7"/>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <PasswordBox x:Name="KeyHidden" Style="{StaticResource SecretField}" PasswordChanged="KeyHidden_Changed"/>
            <TextBox x:Name="KeyShown" Style="{StaticResource Field}" Visibility="Collapsed" TextChanged="KeyShown_Changed"/>
            <Button x:Name="EyeBtn" Grid.Column="1" Style="{StaticResource Ghost}" Margin="6,0,0,0" Click="Eye_Click" ToolTip="Show / hide"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Content="&#xE7B3;" Width="38" Height="38" Padding="0"/>
            <Button x:Name="GenBtn" Grid.Column="2" Style="{StaticResource Ghost}" Click="Generate_Click" ToolTip="Make a random key and copy it"
                    FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Content="&#xE8D7;" Width="38" Height="38" Padding="0"/>
          </Grid>
          <TextBlock Text="Other PC's address (optional, only if it isn't found automatically)" Foreground="{StaticResource Sub}" FontSize="12" Margin="0,14,0,7" TextWrapping="Wrap"/>
          <TextBox x:Name="PeerAddress" Style="{StaticResource Field}" ToolTip="e.g. 192.168.1.42 or DESKTOP-NAME"/>
          <TextBlock x:Name="MyAddress" Foreground="#5E6676" FontSize="11.5" Margin="2,7,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </Border>

      <!-- Switching -->
      <TextBlock Text="SWITCHING" Style="{StaticResource Label}" Margin="2,20,0,8"/>
      <Border Style="{StaticResource CardBox}" Padding="16,10">
        <StackPanel>
          <CheckBox x:Name="OptEdge" Style="{StaticResource Switch}" Content="Push the cursor off the screen edge"/>
          <CheckBox x:Name="OptHotkey" Style="{StaticResource Switch}" Content="Ctrl + Alt + number"/>
          <TextBlock x:Name="HotkeyHint" Foreground="{StaticResource Sub}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,6"/>
        </StackPanel>
      </Border>

      <!-- Sharing -->
      <TextBlock Text="SHARE" Style="{StaticResource Label}" Margin="2,20,0,8"/>
      <Border Style="{StaticResource CardBox}" Padding="16,10">
        <StackPanel>
          <CheckBox x:Name="OptInput" Style="{StaticResource Switch}" Content="Mouse &amp; keyboard"/>
          <CheckBox x:Name="OptText" Style="{StaticResource Switch}" Content="Copied text"/>
          <CheckBox x:Name="OptImages" Style="{StaticResource Switch}" Content="Pictures &amp; screenshots"/>
          <CheckBox x:Name="OptFiles" Style="{StaticResource Switch}" Content="Files &amp; folders"/>
          <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,8"/>
          <CheckBox x:Name="OptStartup" Style="{StaticResource Switch}" Content="Start with Windows (in the tray)"/>
          <CheckBox x:Name="OptAuto" Style="{StaticResource Switch}" Content="Connect automatically on launch"/>
        </StackPanel>
      </Border>

      <!-- Sign-in screen -->
      <TextBlock Text="SIGN-IN SCREEN" Style="{StaticResource Label}" Margin="2,20,0,8"/>
      <Border Style="{StaticResource CardBox}" Padding="16,12">
        <StackPanel>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Sub}" FontSize="12">
            Windows blocks remote control of its sign-in screen (PIN, password, UAC). Installing sign-in support adds a
            small Windows service so you can type your PIN on this PC from the other one. Anyone with your pairing key on
            your network could then use this PC's sign-in screen, though they would still need your PIN or password.
          </TextBlock>
          <Button x:Name="SignInBtn" Style="{StaticResource Ghost}" HorizontalAlignment="Left" Margin="-10,8,0,0"
                  Click="SignIn_Click" Foreground="{StaticResource Accent}" Content="Install sign-in support"/>
        </StackPanel>
      </Border>

      <WrapPanel HorizontalAlignment="Center" Margin="0,12,0,0">
        <Button Style="{StaticResource Ghost}" Content="Received files" Click="OpenReceived_Click"/>
        <Button Style="{StaticResource Ghost}" Content="Allow through firewall" Click="Firewall_Click"
                ToolTip="Adds a Windows Firewall rule for private networks (asks for admin). Needed on both PCs."/>
      </WrapPanel>
    </StackPanel>
    </Grid>
    </ScrollViewer>
  </StackPanel>
  </Border>
</Window>
